# Copy to .env and fill in. Every value here is a DEV value; the deploy
# values are in DEPLOY.md. .env is gitignored, this file is committed so
# nobody has to guess which variables exist.
#
# The api reads this file (`bun run dev` in apps/api passes --env-file).
# The website reads only API_PROXY_URL, and only at BUILD time.

# --- Database ---------------------------------------------------------
# Postgres 16 from docker-compose.yml. Dev-only credentials; a deploy uses
# the managed database's URL, which carries its own password and TLS mode.
DATABASE_URL=postgresql://streakly:streakly@localhost:5432/streakly

# The integration suite creates and drops this database on the same server.
# Optional: it defaults to streakly_test on localhost.
# TEST_DATABASE_URL=postgresql://streakly:streakly@localhost:5432/streakly_test

# --- Better Auth ------------------------------------------------------
# 32+ characters. Required outside development and test; the api refuses to
# boot without it rather than falling back to the well-known dev secret.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The PUBLIC origin browsers see — the website's address, not the api's.
# Better Auth derives its origin check and its secure-cookie flag from this,
# so it must be the exact scheme+host users type. Dev: http://localhost:3000
# Production: https://your-domain
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins allowed to POST to /api/auth/*. Defaults to
# BETTER_AUTH_URL when unset; set it when the site answers on more than one
# origin (www + apex, a preview domain).
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain,https://www.your-domain

# The header your host's edge writes with the visitor's IP. Rate limits are
# keyed on it. Never leave this unset in production: the api refuses to boot.
#   Railway: x-real-ip   Fly: fly-client-ip   Cloudflare: cf-connecting-ip
# "none" means there is no edge proxy (local compose app profile): every
# visitor then shares ONE rate-limit bucket. X-Forwarded-For is never read,
# because any client can set it.
CLIENT_IP_HEADER=none

# --- Email (password reset) ------------------------------------------
# Required outside development and test. Dev prints the email and its link
# to apps/api/api-dev.log instead of sending. resend.dev's test sender only
# delivers to the Resend account's own address.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Streakly <hello@your-domain>

# --- Website ----------------------------------------------------------
# Where the website proxies /api/*. Read at BUILD time: Next bakes it into
# routes-manifest.json, so changing it means rebuilding the image.
# Dev default is http://localhost:4000. In compose/Docker it is http://api:4000.
# API_PROXY_URL=http://localhost:4000

# --- Optional ---------------------------------------------------------
# The api listens on 4000 unless told otherwise.
# PORT=4000
