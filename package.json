{
  "name": "streakly",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run --env-file=.env prisma/seed.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "prisma": "^6.11.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "26.2.0",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "typescript": "5.9.3"
  }
}
